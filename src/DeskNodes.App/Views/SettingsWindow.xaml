<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:core="clr-namespace:DeskNodes.Core.Presentation;assembly=DeskNodes.Core"
    xmlns:views="clr-namespace:DeskNodes.App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    x:Class="DeskNodes.App.Views.SettingsWindow"
    FontSize="{DynamicResource TextSize12}"
    Title="设置 — DeskNodes"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Background="{DynamicResource HistoryBackground}"
    Foreground="{DynamicResource HistoryForeground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="40,20" Grid.IsSharedSizeScope="True">
            <TextBlock Text="通用" FontSize="{DynamicResource TextSize12}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="AppearanceLabel" Content="外观" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=AppearanceLabel}">
                        <ComboBox
                            AutomationProperties.LabeledBy="{Binding ElementName=AppearanceLabel}"
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Appearances}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Appearance, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <CheckBox
                        Style="{StaticResource SettingsCheckBox}"
                        IsEnabled="{Binding CanChangeLogin}"
                        IsChecked="{Binding LoginEnabled, Mode=TwoWay}"
                        AutomationProperties.Name="开机启动 DeskNodes"
                        AutomationProperties.LabeledBy="{Binding ElementName=LoginLabel}">
                        <Label Style="{StaticResource SettingsLabel}" x:Name="LoginLabel" Content="开机启动 DeskNodes" Padding="0"/>
                    </CheckBox>
                    <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="RolloverLabel" Content="跨天时间（HH:mm）" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=RolloverLabel}">
                        <StackPanel>
                            <TextBox
                                AutomationProperties.LabeledBy="{Binding ElementName=RolloverLabel}"
                                Width="180"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Text="{Binding RolloverText, UpdateSourceTrigger=PropertyChanged}"
                                views:CommitOnFocusLoss.Command="{Binding CommitRollover}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommitRollover}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{Binding RolloverError}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Height="16"/>
            <TextBlock Text="便签" FontSize="{DynamicResource TextSize12}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="FontLabel" Content="字体" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=FontLabel}">
                        <ItemsControl
                            AutomationProperties.LabeledBy="{Binding ElementName=FontLabel}"
                            ItemsSource="{Binding FontCards}"
                            ItemTemplate="{StaticResource SettingsFontTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="TextSizeLabel" Content="文字大小" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=TextSizeLabel}">
                        <ComboBox
                            AutomationProperties.LabeledBy="{Binding ElementName=TextSizeLabel}"
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.TextSizes}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding TextSize, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="SampleLabel" Content="示例" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=SampleLabel}">
                        <TextBlock
                            FontFamily="{Binding SampleFamily}"
                            FontSize="{Binding SampleSize}"
                            Text="今日待办 · 文 Aa 123"
                            MinHeight="44"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="NewWidthLabel" Content="新便签宽度" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=NewWidthLabel}">
                        <ComboBox
                            AutomationProperties.LabeledBy="{Binding ElementName=NewWidthLabel}"
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Widths}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding NewWidth, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="NewHeightLabel" Content="新便签高度" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=NewHeightLabel}">
                        <ComboBox
                            AutomationProperties.LabeledBy="{Binding ElementName=NewHeightLabel}"
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Heights}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding NewHeight, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Height="16"/>
            <TextBlock Text="工具条" FontSize="{DynamicResource TextSize12}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="OrientationLabel" Content="排列方向" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=OrientationLabel}">
                        <ComboBox
                            AutomationProperties.LabeledBy="{Binding ElementName=OrientationLabel}"
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Orientations}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Orientation, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="AutoShrinkLabel" Content="闲置自动收缩" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=AutoShrinkLabel}">
                        <ComboBox
                            AutomationProperties.LabeledBy="{Binding ElementName=AutoShrinkLabel}"
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.ShrinkDelays}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding AutoShrink, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="HomeLabel" Content="收缩位置" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=HomeLabel}">
                        <StackPanel>
                            <Canvas Width="180" Height="96" HorizontalAlignment="Left">
                                <Rectangle
                                    Width="180"
                                    Height="96"
                                    RadiusX="6"
                                    RadiusY="6"
                                    Stroke="{DynamicResource HistorySecondary}"/>
                                <Ellipse
                                    Canvas.Left="{Binding HomeX}"
                                    Canvas.Top="{Binding HomeY}"
                                    Width="12"
                                    Height="12"
                                    Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Canvas>
                            <TextBlock Text="固定收缩位置；拖动圆形入口可更改。" TextWrapping="Wrap" Margin="0,6"/>
                            <Button
                                Style="{StaticResource SettingsButton}"
                                Command="{Binding ResetHome}"
                                IsEnabled="{Binding CanResetHome}"
                                Content="恢复默认"
                                HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="AssistiveLabel" Content="辅助技术" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=AssistiveLabel}">
                        <CheckBox
                            Style="{StaticResource SettingsCheckBox}"
                            IsChecked="{Binding KeepToolbarExpanded, Mode=TwoWay}"
                            AutomationProperties.Name="保持工具条展开（辅助技术）"
                            AutomationProperties.LabeledBy="{Binding ElementName=ExpandedLabel}">
                            <Label Style="{StaticResource SettingsLabel}" x:Name="ExpandedLabel" Content="保持工具条展开（辅助技术）" Padding="0"/>
                        </CheckBox>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="MotionLabel" Content="动画" Padding="0" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1"
                        AutomationProperties.LabeledBy="{Binding ElementName=MotionLabel}">
                        <CheckBox
                            Style="{StaticResource SettingsCheckBox}"
                            IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                            AutomationProperties.Name="减少动画"
                            AutomationProperties.LabeledBy="{Binding ElementName=MotionSwitchLabel}">
                            <Label Style="{StaticResource SettingsLabel}" x:Name="MotionSwitchLabel" Content="减少动画" Padding="0"/>
                        </CheckBox>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Height="16"/>
            <TextBlock Text="快捷键" FontSize="{DynamicResource TextSize12}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="NewHotkeyLabel" Padding="0" Content="全局新建" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Style="{StaticResource SettingsButton}"
                            Command="{Binding RecordNew}"
                            Content="{Binding NewHotkey}"
                            AutomationProperties.LabeledBy="{Binding ElementName=NewHotkeyLabel}"
                            AutomationProperties.Name="全局新建"/>
                        <Button
                            Style="{StaticResource SettingsButton}"
                            Command="{Binding ResetNew}"
                            Content="恢复默认"
                            Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NewHotkeyStatus}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Label Style="{StaticResource SettingsLabel}" x:Name="FloatHotkeyLabel" Padding="0" Content="全局浮起" Margin="0,12,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Style="{StaticResource SettingsButton}"
                            Command="{Binding RecordFloat}"
                            Content="{Binding FloatHotkey}"
                            AutomationProperties.LabeledBy="{Binding ElementName=FloatHotkeyLabel}"
                            AutomationProperties.Name="全局浮起"/>
                        <Button
                            Style="{StaticResource SettingsButton}"
                            Command="{Binding ClearFloat}"
                            Content="清除"
                            Margin="12,0,0,0"/>
                        <Button
                            Style="{StaticResource SettingsButton}"
                            Command="{Binding ResetFloat}"
                            Content="恢复默认"
                            Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding FloatHotkeyStatus}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding AltGrWarning}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding HotkeyError}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Height="16"/>
            <TextBlock Text="数据" FontSize="{DynamicResource TextSize12}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SettingsButton}" Command="{Binding Export}" Content="导出…"/>
                    <Button
                        Style="{StaticResource SettingsButton}"
                        Command="{Binding Import}"
                        Content="导入…"
                        Margin="12,0,0,0"/>
                    <TextBlock Text="正在校验…" FontSize="{DynamicResource TextSize12}"
                        VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDataOperationBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Button
                Style="{StaticResource SettingsButton}"
                Command="{Binding OpenLicense}"
                Content="字体授权"
                HorizontalAlignment="Left"
                Margin="14,0,0,12"/>
            <TextBox
                Text="{Binding Error, Mode=OneWay}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{DynamicResource HistoryForeground}"
                AutomationProperties.Name="可复制的设置错误"/>
        </StackPanel>
    </ScrollViewer>
</Window>
