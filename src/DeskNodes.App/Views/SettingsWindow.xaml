<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:core="clr-namespace:DeskNodes.Core.Presentation;assembly=DeskNodes.Core"
    xmlns:views="clr-namespace:DeskNodes.App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    x:Class="DeskNodes.App.Views.SettingsWindow"
    Title="设置 — DeskNodes"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Background="{DynamicResource HistoryBackground}"
    Foreground="{DynamicResource HistoryForeground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="40,20">
            <TextBlock Text="通用" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="外观" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ComboBox
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Appearances}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Appearance, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="跨天时间（HH:mm）" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <StackPanel>
                            <TextBox
                                Width="180"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Text="{Binding RolloverText, UpdateSourceTrigger=PropertyChanged}"
                                views:CommitOnFocusLoss.Command="{Binding CommitRollover}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommitRollover}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{Binding RolloverError}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Height="16"/>
            <TextBlock Text="便签" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="字体" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding FontCards}" ItemTemplate="{StaticResource SettingsFontTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文字大小" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ComboBox
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.TextSizes}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding TextSize, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="示例" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <TextBlock
                            FontFamily="{Binding SampleFamily}"
                            FontSize="{Binding SampleSize}"
                            Text="今日待办 · 文 Aa 123"
                            MinHeight="44"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="新便签宽度" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ComboBox
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Widths}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding NewWidth, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="新便签高度" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ComboBox
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Heights}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding NewHeight, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Height="16"/>
            <TextBlock Text="工具条" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="排列方向" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ComboBox
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.Orientations}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Orientation, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="闲置自动收缩" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <ComboBox
                            Style="{StaticResource SettingsChoice}"
                            ItemsSource="{x:Static core:SettingsOptions.ShrinkDelays}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding AutoShrink, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="收缩位置" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <StackPanel>
                            <Canvas Width="180" Height="96" HorizontalAlignment="Left">
                                <Rectangle Width="180" Height="96" RadiusX="6" RadiusY="6" Stroke="{DynamicResource HistorySecondary}"/>
                                <Ellipse
                                    Canvas.Left="{Binding HomeX}"
                                    Canvas.Top="{Binding HomeY}"
                                    Width="12"
                                    Height="12"
                                    Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Canvas>
                            <TextBlock Text="固定收缩位置；拖动圆形入口可更改。" TextWrapping="Wrap" Margin="0,6"/>
                            <Button
                                Command="{Binding ResetHome}"
                                IsEnabled="{Binding CanResetHome}"
                                Content="恢复默认"
                                HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="辅助技术" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <CheckBox Style="{StaticResource SettingsCheckBox}" IsChecked="{Binding KeepToolbarExpanded, Mode=TwoWay}" Content="保持工具条展开（辅助技术）"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="动画" VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1">
                        <CheckBox Style="{StaticResource SettingsCheckBox}" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Content="减少动画"/>
                    </ContentControl>
                </Grid>
            </Border>
            <Border Height="16"/>
            <Button Style="{StaticResource SettingsButton}" Command="{Binding OpenLicense}" Content="字体授权" HorizontalAlignment="Left" Margin="14,0,0,12"/>
            <TextBox
                Text="{Binding Error, Mode=OneWay}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{DynamicResource HistoryForeground}"
                AutomationProperties.Name="可复制的设置错误"/>
        </StackPanel>
    </ScrollViewer>
</Window>
