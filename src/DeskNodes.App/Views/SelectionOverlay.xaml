<Window x:Class="DeskNodes.App.Views.SelectionOverlay" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True"
 AutomationProperties.Name="便签多选覆盖层，拖动框选，Escape 完成">
 <Canvas ClipToBounds="True" Background="{DynamicResource SelectionShade}">
  <Rectangle Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}" Width="{Binding Width}" Height="{Binding Height}" Fill="{DynamicResource SelectionFill}" Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" StrokeThickness="1" Visibility="{Binding Visibility}"/>
 </Canvas>
</Window>
