<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    x:Class="DeskNodes.App.Views.NoteWindow"
    x:ClassModifier="internal"
    Title="DeskNodes 便签"
    ShowActivated="False"
    WindowStyle="None"
    ShowInTaskbar="False"
    ResizeMode="CanResize"
    MinWidth="200"
    MaxWidth="400"
    MinHeight="120"
    MaxHeight="600"
    Style="{StaticResource NoteSurface}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="13"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Border
            x:Name="shell"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
            CornerRadius="{Binding Radius}"
            Padding="18,0">
            <Grid x:Name="layout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding HeaderHeight}"/>
                    <RowDefinition/>
                    <RowDefinition Height="{Binding FooterHeight}"/>
                </Grid.RowDefinitions>
                <Grid x:Name="header" MouseLeftButtonDown="HeaderDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="heading" Margin="{Binding HeadingMargin}">
                        <TextBox
                            x:Name="title"
                            FontFamily="{Binding Font}"
                            FontSize="{Binding TitleSize}"
                            FontWeight="{Binding TitleWeight}"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="便签标题">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource NoteEditor}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Collapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock
                            Text="标题"
                            IsHitTestVisible="False"
                            Foreground="{DynamicResource Secondary}"
                            VerticalAlignment="Center"
                            FontFamily="{Binding Font}"
                            FontSize="{Binding TitleSize}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition
                                                    Binding="{Binding Text.Length, ElementName=title}"
                                                    Value="0"/>
                                                <Condition Binding="{Binding Collapsed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            x:Name="summary"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis"
                            FontFamily="{Binding Font}"
                            FontWeight="{Binding TitleWeight}"
                            FontSize="{DynamicResource TextSize14}"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Body}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Collapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel
                        x:Name="right"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{Binding CountMargin}">
                        <TextBlock
                            Text="{Binding Count}"
                            FontFamily="Segoe UI"
                            Typography.NumeralAlignment="Tabular"
                            FontSize="{Binding SecondarySize}"
                            Foreground="{DynamicResource Secondary}"
                            VerticalAlignment="Center"/>
                        <Button x:Name="more" Content="&#xE712;" ToolTip="便签菜单" AutomationProperties.Name="便签菜单">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MoreButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=header}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsKeyboardFocusWithin, ElementName=header}"
                                            Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border
                        Width="30"
                        Height="10"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Cursor="SizeAll"
                        Panel.ZIndex="1"
                        MouseLeftButtonDown="Drag">
                        <Border Width="22" Height="3" CornerRadius="2" Background="{DynamicResource Secondary}"/>
                    </Border>
                </Grid>
                <ScrollViewer
                    x:Name="scroll"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,18"
                    Style="{StaticResource ExpandedScroll}">
                    <StackPanel x:Name="rows"/>
                </ScrollViewer>
                <Border
                    Grid.Row="2"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    Style="{StaticResource ExpandedBorder}">
                    <Button
                        x:Name="add"
                        Content="添加事项"
                        Style="{StaticResource AddItemButton}"
                        FontFamily="{Binding Font}"
                        FontSize="{Binding AddSize}"
                        AutomationProperties.Name="添加事项"/>
                </Border>
            </Grid>
        </Border>
        <Border
            x:Name="outline"
            Style="{StaticResource NoteOutline}"
            CornerRadius="{Binding Radius}"
            BorderThickness="1.5"
            IsHitTestVisible="False"
            Opacity="{Binding SelectionOpacity}"/>
        <Border
            Style="{StaticResource NotePickedOutline}"
            BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
            BorderThickness="2"
            CornerRadius="13"
            IsHitTestVisible="False">
            <Border
                Width="22"
                Height="22"
                CornerRadius="11"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
                <TextBlock
                    Text="✓"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Border>
        </Border>
    </Grid>
</Window>
