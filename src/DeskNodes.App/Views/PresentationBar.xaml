<Window x:Class="DeskNodes.App.Views.PresentationBar" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" SizeToContent="Manual"
 AutomationProperties.Name="{Binding Message}" Background="{DynamicResource ToolbarBackground}" Foreground="{DynamicResource ToolbarForeground}">
 <Border BorderBrush="{DynamicResource ToolbarBorder}" BorderThickness="1" CornerRadius="12" Padding="12,4">
  <DockPanel LastChildFill="True" AutomationProperties.Name="{Binding Message}">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Style="{StaticResource PresentationAction}" x:Name="all" Content="全选" Margin="4,0" Click="All"/>
    <Button Style="{StaticResource PresentationAction}" ToolTipService.ShowOnDisabled="True" x:Name="action" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" ToolTip="{Binding ActionHelp}" AutomationProperties.HelpText="{Binding ActionHelp}" Margin="4,0" Click="Act"/>
    <Button Style="{StaticResource PresentationAction}" x:Name="done" Content="完成" Margin="4,0" Click="Done"/>
   </StackPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="54" VerticalAlignment="Center"/>
  </DockPanel>
 </Border>
</Window>
