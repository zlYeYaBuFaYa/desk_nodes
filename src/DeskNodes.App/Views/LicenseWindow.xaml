<Window
    x:Class="DeskNodes.App.Views.LicenseWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="霞鹜文楷 — SIL Open Font License"
    Background="{DynamicResource HistoryBackground}"
    Foreground="{DynamicResource HistoryForeground}">
    <TextBox
        Text="{Binding LicenseText, Mode=OneWay}"
        IsReadOnly="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
        Padding="20"
        BorderThickness="0"
        Background="{DynamicResource HistoryBackground}"
        Foreground="{DynamicResource HistoryForeground}"
        AutomationProperties.Name="字体授权全文"/>
</Window>
