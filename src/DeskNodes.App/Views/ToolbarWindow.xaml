<Window
    x:Class="DeskNodes.App.Views.ToolbarWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:DeskNodes.App.Views"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    Background="{DynamicResource ToolbarBackground}"
    Foreground="{DynamicResource ToolbarForeground}"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    FontSize="{DynamicResource TextSize12}"
    SizeToContent="Manual">
    <Window.Resources>
        <DataTemplate DataType="{x:Type views:ToolbarActionViewModel}">
            <Button
                Style="{StaticResource ToolbarActionSize}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                AutomationProperties.Name="{Binding AutomationName}"
                MouseEnter="ActionMouseEnter"
                MouseLeave="ActionMouseLeave">
                <StackPanel>
                    <TextBlock
                        Text="{Binding Icon}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="17"
                        HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate DataType="{x:Type views:ToolbarHandleViewModel}">
            <Grid
                Style="{StaticResource ToolbarHandle}"
                Loaded="GripLoaded"
                Cursor="SizeAll"
                AutomationProperties.Name="移动工具条">
                <Canvas Width="9" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource ToolbarSecondary}"/>
                    <Ellipse Canvas.Left="6" Width="3" Height="3" Fill="{DynamicResource ToolbarSecondary}"/>
                    <Ellipse Canvas.Top="6" Width="3" Height="3" Fill="{DynamicResource ToolbarSecondary}"/>
                    <Ellipse
                        Canvas.Left="6"
                        Canvas.Top="6"
                        Width="3"
                        Height="3"
                        Fill="{DynamicResource ToolbarSecondary}"/>
                    <Ellipse Canvas.Top="12" Width="3" Height="3" Fill="{DynamicResource ToolbarSecondary}"/>
                    <Ellipse
                        Canvas.Left="6"
                        Canvas.Top="12"
                        Width="3"
                        Height="3"
                        Fill="{DynamicResource ToolbarSecondary}"/>
                </Canvas>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type views:ToolbarCountViewModel}">
            <Button
                Content="{Binding CountText}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource ToolbarCount}"
                AutomationProperties.Name="{Binding CountText}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type views:ToolbarPagingViewModel}">
            <StackPanel Style="{StaticResource ToolbarPaging}">
                <Button
                    Content="‹"
                    Width="14"
                    Style="{StaticResource ToolbarAction}"
                    Command="{Binding Prev}"
                    IsEnabled="{Binding CanPrev}"
                    AutomationProperties.Name="上一页"/>
                <TextBlock Text="{Binding PageText}" Style="{StaticResource ToolbarPageText}"/>
                <Button
                    Content="›"
                    Width="14"
                    Style="{StaticResource ToolbarAction}"
                    Command="{Binding Next}"
                    IsEnabled="{Binding CanNext}"
                    AutomationProperties.Name="下一页"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border
        x:Name="Shell"
        CornerRadius="32"
        BorderThickness="0.5"
        BorderBrush="{DynamicResource ToolbarBorder}"
        Background="{DynamicResource ToolbarBackground}">
        <Grid ClipToBounds="True">
            <Border
                x:Name="Hover"
                Background="{DynamicResource ToolbarHover}"
                CornerRadius="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HoverPosition"/>
                </Border.RenderTransform>
            </Border>
            <DockPanel x:Name="Parts" Style="{StaticResource ToolbarContent}">
                <ContentControl x:Name="FixedHandle">
                    <ContentControl.Content>
                        <views:ToolbarHandleViewModel/>
                    </ContentControl.Content>
                </ContentControl>
                <Button
                    x:Name="ScrollBack"
                    Style="{StaticResource ToolbarScroll}"
                    Content="‹"
                    AutomationProperties.Name="向前滚动工具条"
                    Click="ScrollToolbarBack"/>
                <Button
                    x:Name="ScrollForward"
                    Style="{StaticResource ToolbarScroll}"
                    Content="›"
                    AutomationProperties.Name="向后滚动工具条"
                    Click="ScrollToolbarForward"/>
                <ScrollViewer
                    x:Name="ActionScroll"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden"
                    ScrollChanged="ToolbarScrollChanged">
                    <ItemsControl x:Name="ActionParts" ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="{Binding Orientation}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <Viewbox
                x:Name="RoundLabel"
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <Path
                        Data="M 5,2 L 19,2 19,17 14,22 5,22 Z M 14,22 L 14,17 19,17 M 8,10 L 11,13 16,7"
                        Stroke="{DynamicResource ToolbarForeground}"
                        StrokeThickness="1.6"
                        StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>
            <Border
                Background="{DynamicResource ToolbarForeground}"
                CornerRadius="9"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="{Binding BadgeVisible, Converter={StaticResource ToolbarVisibility}}">
                <TextBlock
                    Text="{Binding BadgeText}"
                    Foreground="{DynamicResource ToolbarBackground}"
                    FontSize="{DynamicResource TextSize11}"
                    Margin="4,1"/>
            </Border>
            <Popup
                x:Name="entranceHit"
                AllowsTransparency="True"
                StaysOpen="True"
                Focusable="False"
                Placement="Relative">
                <views:EntranceHitView
                    x:Name="Entrance"
                    MouseEnter="EntranceEnter"
                    MouseLeave="EntranceEnter"
                    PreviewMouseLeftButtonDown="Down"
                    PreviewMouseRightButtonUp="OpenMenu"
                    DragEnter="EntranceDragEnter"
                    DragLeave="EntranceDragEnd"
                    Drop="EntranceDragEnd"/>
            </Popup>
            <Popup x:Name="stackHint" AllowsTransparency="True" StaysOpen="True" Focusable="False" Placement="Relative">
                <views:StackHintView x:Name="StackHint" MouseLeftButtonUp="StackHintClick"/>
            </Popup>
        </Grid>
    </Border>
</Window>
