<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>Assets/DeskNodes.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>DeskNodes</Product>
    <Company></Company>
    <!-- The SDK otherwise defaults an empty Company to the assembly name. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Copyright>Copyright © 2026 DeskNodes contributors</Copyright>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF owns process DPI awareness; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DeskNodes.Core/DeskNodes.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/DeskNodes.ico" />
    <Resource Include="Resources/Fonts/*" Condition="Exists('Resources/Fonts')" />
  </ItemGroup>
</Project>
