<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SettingsLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource HistoryForeground}"/>
    </Style>
    <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource HistoryForeground}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource HistoryForeground}"/>
    </Style>
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource HistoryWeak}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="SettingsChoice" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsFontCard" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="MinHeight" Value="62"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Frame"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource HistoryTrack}"
                        Background="{DynamicResource HistoryBackground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter
                                TargetName="Frame"
                                Property="BorderBrush"
                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="SettingsFontTemplate">
        <RadioButton
            Style="{StaticResource SettingsFontCard}"
            GroupName="NoteFont"
            AutomationProperties.LabeledBy="{Binding ElementName=FontLabel}"
            AutomationProperties.Name="{Binding AccessibleName}"
            IsChecked="{Binding IsSelected, Mode=OneWay}"
            Command="{Binding Select}">
            <StackPanel>
                <TextBlock Text="文 Aa" FontSize="{DynamicResource TextSize18}" FontFamily="{Binding Family}" HorizontalAlignment="Center"/>
                <Label Style="{StaticResource SettingsLabel}" x:Name="FontLabel" Padding="0" Content="{Binding Label}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Status}" FontSize="{DynamicResource TextSize10}" HorizontalAlignment="Center"/>
            </StackPanel>
        </RadioButton>
    </DataTemplate>
</ResourceDictionary>
