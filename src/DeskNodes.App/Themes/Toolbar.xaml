<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="ToolbarVisibility"/>
    <Style x:Key="ToolbarAction" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolbarForeground}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ToolbarDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolbarActionSize" TargetType="Button" BasedOn="{StaticResource ToolbarAction}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Horizontal">
                <Setter Property="Width" Value="60"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarCount" TargetType="Button" BasedOn="{StaticResource ToolbarAction}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="32"/>
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Horizontal">
                <Setter Property="Width" Value="68"/>
                <Setter Property="Height" Value="52"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarHandle" TargetType="Grid">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Horizontal">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="52"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarPaging" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="28"/>
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Horizontal">
                <Setter Property="Width" Value="64"/>
                <Setter Property="Height" Value="52"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarPageText" TargetType="TextBlock">
        <Setter Property="Width" Value="24"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Horizontal">
                <Setter Property="Width" Value="36"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarParts" TargetType="ItemsControl">
        <Setter Property="Margin" Value="6,16"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Orientation}" Value="Horizontal">
                <Setter Property="Margin" Value="16,6"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StackHintSheet" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorder}"/>
    </Style>
</ResourceDictionary>
