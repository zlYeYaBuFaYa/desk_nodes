<Application
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="DeskNodes.App.App"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Settings.xaml"/>
                <ResourceDictionary Source="Themes/Toolbar.xaml"/>
                <ResourceDictionary Source="Themes/History.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="TextSize10">10</sys:Double>
            <sys:Double x:Key="TextSize11">11</sys:Double>
            <sys:Double x:Key="TextSize12">12</sys:Double>
            <sys:Double x:Key="TextSize14">14</sys:Double>
            <sys:Double x:Key="TextSize18">18</sys:Double>
            <sys:Double x:Key="TextSize20">20</sys:Double>
            <sys:Double x:Key="TextSize24">24</sys:Double>
            <sys:Double x:Key="TextSize32">32</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
